{
  "name": "auto-git-wiki",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build -w @autowiki/shared && concurrently -k -n shared,server,web -c gray,magenta,cyan \"npm:dev -w @autowiki/shared\" \"npm:dev -w @autowiki/server\" \"npm:dev -w @autowiki/web\"",
    "build": "npm run build -w @autowiki/shared && npm run build -w @autowiki/server && npm run build -w @autowiki/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run build -w @autowiki/shared && npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w @autowiki/server",
    "db:migrate": "npm run db:migrate -w @autowiki/server",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "inngest:dev": "npx --yes inngest-cli@latest dev -u http://localhost:4000/api/inngest",
    "test": "npm run test --workspaces --if-present",
    "dev:chunks": "tsx apps/server/src/scripts/dev-chunks.ts",
    "dev:search": "tsx apps/server/src/scripts/dev-search.ts",
    "eval:retrieval": "tsx apps/server/src/scripts/eval-retrieval.ts",
    "eval:retrieval:heldout": "tsx apps/server/src/scripts/eval-retrieval.ts --set apps/server/eval/retrieval-heldout.json",
    "dev:ask": "tsx apps/server/src/scripts/dev-ask.ts",
    "dev:wiki": "tsx apps/server/src/scripts/dev-wiki.ts",
    "eval:memory": "tsx apps/server/src/scripts/eval-memory.ts",
    "eval:injection": "tsx apps/server/src/scripts/eval-injection.ts",
    "dev:session": "tsx apps/server/src/scripts/dev-session.ts",
    "billing:sync-plans": "tsx apps/server/src/scripts/billing-sync-plans.ts",
    "billing:cost-report": "tsx apps/server/src/scripts/billing-cost-report.ts",
    "billing:simulate": "tsx apps/server/src/scripts/billing-simulate-webhook.ts",
    "check:contrast": "npm run check:contrast -w @autowiki/web",
    "capture:screenshots": "tsx scripts/capture-screenshots.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mermaid-js/mermaid-cli": "^12.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
