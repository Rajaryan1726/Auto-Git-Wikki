# ---- Server ----
PORT=4000
# Origin of the web app (used for CORS with credentials)
WEB_ORIGIN=http://localhost:5173
# Public URL of the API server (used for OAuth callbacks later)
SERVER_URL=http://localhost:4000
# API base URL used by the web app (exposed to the browser)
VITE_API_URL=http://localhost:4000

# ---- Local infra host ports (read by docker-compose; change if a port is taken) ----
POSTGRES_HOST_PORT=5432
QDRANT_HOST_PORT=6333

# ---- Database / vector store (must match the host ports above) ----
DATABASE_URL=postgres://autowiki:autowiki@localhost:5432/autowiki
QDRANT_URL=http://localhost:6333
# Optional: only needed for Qdrant Cloud / secured instances
QDRANT_API_KEY=

# ---- Inngest (leave empty for the local dev server) ----
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---- GitHub OAuth app ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Secrets ----
# At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_JWT_SECRET=
# 32 bytes, base64-encoded. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# ---- LLM / embeddings ----
GEMINI_API_KEY=
OPENAI_API_KEY=
# Generation models (verified 2026-10-04 against the docs and both model-list APIs)
GEN_MODEL_PRIMARY=gemini-3.8-flash
GEN_MODEL_FALLBACK=gpt-6-luna
# Embedding model: the provider follows the model id (gemini-* -> Gemini, text-embedding-* -> OpenAI).
# Verified 2026-10-04: text-embedding-3-small (8192 input tokens, `dimensions` 768 supported)
# or gemini-embedding-2 (128-3072 dims). Changing it only affects NEW index jobs.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=768

# Embedding throttles (per server process, one per provider)
EMBED_CONCURRENCY=2
# Gemini meters embeddings PER TEXT (a batch of 50 counts 50); free-tier limit for
# gemini-embedding-2 is 100 texts/min and ~1000/day (measured 2026-10-04).
GEMINI_EMBED_MAX_RPM=90
GEMINI_EMBED_BATCH_SIZE=100
GEMINI_EMBED_MAX_TPM=0
# OpenAI meters per call and per token; raise these on higher usage tiers.
OPENAI_EMBED_MAX_RPM=500
OPENAI_EMBED_MAX_TPM=900000
OPENAI_EMBED_BATCH_SIZE=128
