# ---- Server ----
PORT=4000
# Origin of the web app (used for CORS with credentials)
WEB_ORIGIN=http://localhost:5173
# Public URL of the API server (used for OAuth callbacks later)
SERVER_URL=http://localhost:4000
# API base URL used by the web app (exposed to the browser)
VITE_API_URL=http://localhost:4000

# ---- Local infra host ports (read by docker-compose; change if a port is taken) ----
POSTGRES_HOST_PORT=5432
QDRANT_HOST_PORT=6333

# ---- Database / vector store (must match the host ports above) ----
DATABASE_URL=postgres://autowiki:autowiki@localhost:5432/autowiki
QDRANT_URL=http://localhost:6333
# Optional: only needed for Qdrant Cloud / secured instances
QDRANT_API_KEY=

# ---- Inngest (leave empty for the local dev server) ----
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---- GitHub OAuth app ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Secrets ----
# At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_JWT_SECRET=
# 32 bytes, base64-encoded. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# ---- LLM / embeddings ----
GEMINI_API_KEY=
OPENAI_API_KEY=
GEN_MODEL_PRIMARY=gemini-2.5-flash
GEN_MODEL_FALLBACK=gpt-4o-mini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768
